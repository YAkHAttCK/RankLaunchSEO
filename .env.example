# At least one search provider is required for live discovery/audits.
SERPAPI_API_KEY=
GOOGLE_PLACES_API_KEY=

# Vapi outbound calls are enabled only when all three values are set.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# Retell outbound calls.
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=

# Twilio outbound calls. TWILIO_TWIML_URL must return valid call instructions.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TWIML_URL=

# Optional: comma-separated origins allowed to use the API (same-origin is always allowed).
APP_ALLOWED_ORIGINS=
